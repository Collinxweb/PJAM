  ["🏅", "Rank", "rank"],
];

export default function App() {
  const [themeKey, setThemeKey] = useState("meadow");
  const [screen, setScreen] = useState("home");
  const [activeZone, setActiveZone] = useState(null);
  const t = THEMES[themeKey];

  const goTo = (s) => {
    setActiveZone(null);
    setScreen(s);
  };
  const openZone = (z) => {
    setActiveZone(z);
    setScreen("zone");
  };

  let body;
  if (screen === "zone") body = <ZoneDetailScreen t={t} zone={activeZone} back={() => goTo("home")} />;
  else if (screen === "onboarding") body = <OnboardingScreen t={t} />;
  else if (screen === "explore") body = <ExploreScreen t={t} openZone={openZone} />;
  else if (screen === "backpack") body = <BackpackScreen t={t} />;
  else if (screen === "rank") body = <RankScreen t={t} />;
  else body = <HomeScreen t={t} goTo={goTo} openZone={openZone} />;

  return (
    <div
      className="w-full min-h-screen flex justify-center py-6"
      style={{
        background: `linear-gradient(180deg, ${t.bgFrom} 0%, ${t.bgTo} 100%)`,
        fontFamily: "'Nunito', sans-serif",
        transition: "background 0.4s ease",
      }}
    >
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;800&family=Nunito:wght@600;700;800&display=swap');
      `}</style>

      <div
        className="w-full max-w-sm rounded-[2.5rem] overflow-hidden relative"
        style={{ border: `4px solid ${t.ink}`, boxShadow: `6px 8px 0 ${t.in